# bump: godsect-version /GODSECT_VERSION="(.*)"/ git:https://github.com/IBM/godect.git|semver:*
GODSECT_VERSION="1.0.10"
export GODSECT_VERSION

export ZOPEN_STABLE_URL="https://github.com/IBM/godsect.git"
export ZOPEN_STABLE_DEPS="check_go"
export ZOPEN_BUILD_LINE="STABLE"
export ZOPEN_CATEGORIES="devops utilities"

export ZOPEN_COMP=GO
export ZOPEN_CONFIGURE="skip"
export ZOPEN_CONFIGURE_MINIMAL=1
export ZOPEN_MAKE="zopen_build"
export ZOPEN_MAKE_MINIMAL=1
export ZOPEN_CHECK="skip"
export ZOPEN_CLEAN="zopen_clean"
export ZOPEN_INSTALL="zopen_install"
export ZOPEN_COMP=GO

zopen_init()
{
  export CGO_ENABLED=0
  export GOBIN=$ZOPEN_INSTALL_DIR/bin
  mkdir -p $ZOPEN_INSTALL_DIR
}

zopen_build()
{
  echo $PWD
  go version
  go build 
}

zopen_clean()
{
  pwd 
  true
}

zopen_install()
{
  go install 
}

zopen_get_version()
{
  echo "1.0.0"
}
